  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.frontend.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "build:watch:frontend": "tsc -p tsconfig.frontend.json --watch",
    "db:reset": "docker compose down -v && docker compose up -d",
    "auth:user": "node --env-file=.env dist/ops/user.js",
    "start": "node --env-file=.env dist/example/index.js",
    "dev": "node --env-file=.env --watch dist/example/index.js"
  },
  "keywords": [],
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "system-definition": "^0.1.3",
    "tab-plus": "^0.1.8",
    "xlsx-now": "^0.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
