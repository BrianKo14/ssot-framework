{
  "name": "ssot-framework",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && rm -rf public/_app && tsc -p tsconfig.frontend.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "build:watch:frontend": "tsc -p tsconfig.frontend.json --watch",
    "db:create": "node --env-file=.env dist/example/index.js schema",
    "db:update": "node --env-file=.env dist/example/index.js update",
    "db:down": "docker compose down -v",
    "db:up": "docker compose up -d",
    "db:seed": "node --env-file=.env dist/example/index.js seed",
    "db:reset": "docker compose down -v && docker compose up -d && npm run db:create -- --apply && npm run db:seed -- --apply",
    "auth:user": "node --env-file=.env dist/ops/user.js",
    "locks": "node --env-file=.env dist/example/index.js locks",
    "start": "node --env-file=.env dist/example/index.js start",
    "dev": "node --env-file=.env --watch dist/example/index.js start"
  },
  "keywords": [],
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "system-definition": "^0.3.0",
    "tab-plus": "^0.1.8",
    "xlsx-now": "^0.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
